# Copy this file to .env.local and fill in the values.
# .env.local is gitignored — never commit real keys.

# Supabase → Project Settings → API. The URL and publishable (anon) key are
# safe to expose to the browser because Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Where magic links send you back to. Must also be in Supabase → Authentication
# → URL Configuration → Redirect URLs (as <site>/auth/confirm).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Never add the service role / secret key to a NEXT_PUBLIC_ variable.
